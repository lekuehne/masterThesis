  doi = {10.3390/cells10102507},
  urldate = {2024-04-13},
  abstract = {Sphingolipids, associated enzymes, and the sphingolipid pathway are implicated in complex, multifaceted roles impacting several cell functions, such as cellular homeostasis, apoptosis, cell differentiation, and more through intrinsic and autocrine/paracrine mechanisms. Given this broad range of functions, it comes as no surprise that a large body of evidence points to important functions of sphingolipids in hematopoiesis. As the understanding of the processes that regulate hematopoiesis and of the specific characteristics that define each type of hematopoietic cells is being continuously refined, the understanding of the roles of sphingolipid metabolism in hematopoietic lineage commitment is also evolving. Recent findings indicate that sphingolipid alterations can modulate lineage commitment from stem cells all the way to megakaryocytic, erythroid, myeloid, and lymphoid cells. For instance, recent evidence points to the ability of de novo sphingolipids to regulate the stemness of hematopoietic stem cells while a substantial body of literature implicates various sphingolipids in specialized terminal differentiation, such as thrombopoiesis. This review provides a comprehensive discussion focused on the mechanisms that link sphingolipids to the commitment of hematopoietic cells to the different lineages, also highlighting yet to be resolved questions.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  keywords = {ceramide,erythrocytes,hematopoiesis,hematopoietic stem cells,lineage commitment,lymphoid differentiation,megakaryocytes,myeloid differentiation,sphingolipids,sphingosine-1-phosphate},
  file = {/home/bert/Zotero/storage/4JGRTDVN/Raza et al. - 2021 - Sphingolipids in Hematopoiesis Exploring Their Ro.pdf}
}

