@article{rahmani_2019,
  title = {Intestinal Organoids: {{A}} New Paradigm for Engineering Intestinal Epithelium in Vitro},
  shorttitle = {Intestinal Organoids},
  author = {Rahmani, Sara and Breyner, Natalia M. and Su, Hsuan-Ming and Verdu, Elena F. and Didar, Tohid F.},
