}

@article{richter_2020,
  title = {Phage-Assisted Evolution of an Adenine Base Editor with Improved {{Cas}} Domain Compatibility and Activity},
  author = {Richter, Michelle F. and Zhao, Kevin T. and Eton, Elliot and Lapinaite, Audrone and Newby, Gregory A. and Thuronyi, B. W. and Wilson, Christopher and Koblan, Luke W. and Zeng, Jing and Bauer, Daniel E. and Doudna, Jennifer A. and Liu, David R.},
  year = 2020,
