  author = {Bryant, Katherine L. and Hansen, Christi and Hecht, Erin E.},
  year = 2023,
  month = nov,
  journal = {Communications Biology},
  volume = {6},
  number = {1},
  pages = {1190},
  issn = {2399-3642},
  doi = {10.1038/s42003-023-05517-3},
  urldate = {2026-09-05},
  abstract = {Abstract             Brain tissue is metabolically expensive. Consequently, the evolution of humans' large brains must have occurred via concomitant shifts in energy expenditure and intake. Proposed mechanisms include dietary shifts such as cooking. Importantly, though, any new food source must have been exploitable by hominids with brains a third the size of modern humans'. Here, we propose the initial metabolic trigger of hominid brain expansion was the consumption of externally fermented foods. We define ``external fermentation'' as occurring outside the body, as opposed to the internal fermentation in the gut. External fermentation could increase the bioavailability of macro- and micronutrients while reducing digestive energy expenditure and is supported by the relative reduction of the human colon. We discuss the explanatory power of our hypothesis and survey external fermentation practices across human cultures to demonstrate its viability across a range of environments and food sources. We close with suggestions for empirical tests.},
  langid = {english},
  keywords = {/unread},
  file = {/home/bert/Zotero/storage/QJWXX68C/bryant_et_al.-2023-fermentation_technology_as_a_driver_of_human_brain_expansion.pdf}
}

