@article{nijkamp_2012,
  title = {De Novo Sequencing, Assembly and Analysis of the Genome of the Laboratory Strain {{Saccharomyces}} Cerevisiae {{CEN}}.{{PK113-7D}}, a Model for Modern Industrial Biotechnology},
  author = {Nijkamp, Jurgen F. and {van den Broek}, Marcel and Datema, Erwin and {de Kok}, Stefan and Bosman, Lizanne and Luttik, Marijke A. and {Daran-Lapujade}, Pascale and Vongsangnak, Wanwipa and Nielsen, Jens and Heijne, Wilbert H.M. and Klaassen, Paul and Paddon, Chris J. and Platt, Darren and K{\"o}tter, Peter and {van Ham}, Roeland C. and Reinders, Marcel J.T. and Pronk, Jack T. and {de Ridder}, Dick and Daran, Jean Marc},
  year = 2012,
  journal = {Microbial Cell Factories},
  volume = {11},
  number = {March},
  issn = {14752859},
  doi = {10.1186/1475-2859-11-36},
  abstract = {Saccharomyces cerevisiae CEN.PK 113-7D is widely used for metabolic engineering and systems biology research in industry and academia. We sequenced, assembled, annotated and analyzed its genome. Single-nucleotide variations (SNV), insertions/deletions (indels) and differences in genome organization compared to the reference strain S. cerevisiae S288C were analyzed. In addition to a few large deletions and duplications, nearly 3000 indels were identified in the CEN.PK113-7D genome relative to S288C. These differences were overrepresented in genes whose functions are related to transcriptional regulation and chromatin remodelling. Some of these variations were caused by unstable tandem repeats, suggesting an innate evolvability of the corresponding genes. Besides a previously characterized mutation in adenylate cyclase, the CEN.PK113-7D genome sequence revealed a significant enrichment of non-synonymous mutations in genes encoding for components of the cAMP signalling pathway. Some phenotypic characteristics of the CEN.PK113-7D strains were explained by the presence of additional specific metabolic genes relative to S288C. In particular, the presence of the BIO1 and BIO6 genes correlated with a biotin prototrophy of CEN.PK113-7D. Furthermore, the copy number, chromosomal location and sequences of the MAL loci were resolved. The assembled sequence reveals that CEN.PK113-7D has a mosaic genome that combines characteristics of laboratory strains and wild-industrial strains. \copyright{} 2012 Nijkamp et al; licensee BioMed Central Ltd.},
  pmid = {22448915}
}

@article{nishimasu_2018,
  title = {Engineered {{CRISPR-Cas9}} Nuclease with Expanded Targeting Space},
  author = {Nishimasu, Hiroshi and Shi, Xi and Ishiguro, Soh and Gao, Linyi and Hirano, Seiichi and Okazaki, Sae and Noda, Taichi and Abudayyeh, Omar O. and Gootenberg, Jonathan S. and Mori, Hideto and Oura, Seiya and Holmes, Benjamin and Tanaka, Mamoru and Seki, Motoaki and Hirano, Hisato and Aburatani, Hiroyuki and Ishitani, Ryuichiro and Ikawa, Masahito and Yachie, Nozomu and Zhang, Feng and Nureki, Osamu},
